---
/**
 * Everything the original pages did not carry: install metadata, the canonical
 * link, and the machine-readable layer that answer engines read. Page-specific
 * title, description and Open Graph tags stay in each page's own head, exactly
 * as they were authored.
 */
const site = "https://baikapp.com";
// the build writes pages as name.html; their public addresses carry no .html and the home page is just /
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "/").replace(/\/+$/, "");
const canonical = path ? new URL(path, site).href : site + "/";
---
<!-- Google tag (gtag.js) · Google Analytics G-VP0JPM141Z, on every page that uses this head -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VP0JPM141Z"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-VP0JPM141Z');
</script>

<link rel="canonical" href={canonical} />

<!-- link previews (WhatsApp, Telegram, Facebook, X): every address absolute, one share image for every page -->
<meta property="og:url" content={canonical} />
<meta property="og:image" content={site + "/og-baik.jpg"} />
<meta property="og:image:secure_url" content={site + "/og-baik.jpg"} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Baik: the right dua for what you are facing. Three dua cards fanned beside the Baik wordmark." />
<meta name="twitter:image" content={site + "/og-baik.jpg"} />

<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/icons/icon-180.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Baik" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="application-name" content="Baik" />
<meta name="format-detection" content="telephone=no" />

<script is:inline>
  if ('serviceWorker' in navigator) {
    addEventListener('load', function () {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    });
  }
</script>
