{"@context":"https://schema.org","@graph":[
 {"@type":"WebSite","name":"Baik","description":"A card deck of authentic duas. Say what you are facing and draw the right dua.","inLanguage":["en-MY","ms-MY"]},
 {"@type":"MobileApplication","name":"Baik","applicationCategory":"LifestyleApplication",
  "operatingSystem":"Web, iOS, Android","inLanguage":["en-MY","ms-MY"],
  "description":"A dua card deck: Arabic, transliteration, meaning and source on every card. Free forever on the web.",
  "offers":[{"@type":"Offer","price":"0","priceCurrency":"MYR","name":"Free"},
            {"@type":"Offer","price":"19.90","priceCurrency":"MYR","name":"Premium monthly"},
            {"@type":"Offer","price":"179.10","priceCurrency":"MYR","name":"Premium annual"},
            {"@type":"Offer","price":"358.20","priceCurrency":"MYR","name":"Premium lifetime"}]}
]}
</script>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2064%2064%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%2260%22%20height%3D%2260%22%20rx%3D%2217%22%20fill%3D%22%231E2124%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2234%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22central%22%20font-family%3D%22Space%20Grotesk%2C%20Helvetica%2C%20sans-serif%22%20font-weight%3D%22700%22%20font-size%3D%2240%22%20fill%3D%22%23FFFFFF%22%3Eb%3C%2Ftext%3E%3C%2Fsvg%3E">
