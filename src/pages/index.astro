<script is:inline>
/* the phone video plays only while it is on screen, and not at all for reduced motion */
(function(){var v=document.querySelector('.app-vid');if(!v)return;
 if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var p=v.play();p&&p.catch(function(){});}else v.pause();});},{threshold:.25}).observe(v);})();
</script>
<script is:inline>
/* phones: dots under each swipe rail (site.css turns these lists into rails below 760px) */
(function(){
 document.querySelectorAll('.stack,.feats,.quotes,.qtc').forEach(function(rail){
  var cards=[].filter.call(rail.children,function(c){return c.nodeType===1;});if(cards.length<2)return;
  var dots=document.createElement('div');dots.className='rail-dots';dots.setAttribute('aria-hidden','true');
  dots.innerHTML=cards.map(function(_,i){return '<i'+(i?'':' class="on"')+'></i>';}).join('');
  rail.parentNode.insertBefore(dots,rail.nextSibling);
  var raf=0;rail.addEventListener('scroll',function(){if(raf)return;raf=requestAnimationFrame(function(){raf=0;
   var x=rail.scrollLeft,best=0,bd=1e9;cards.forEach(function(c,i){var d=Math.abs(c.offsetLeft-rail.offsetLeft-16-x);if(d<bd){bd=d;best=i;}});
   if(rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-4)best=cards.length-1;
   [].forEach.call(dots.children,function(d,i){d.classList.toggle('on',i===best);});});},{passive:true});
 });
})();
/* How it works: the step in view drives the stage; on phones the stage plays the steps by itself */
(function(){
 var st=document.querySelector('.hw-stage'),steps=[].slice.call(document.querySelectorAll('.hw-step'));if(!st)return;
 var q=st.querySelector('.hw-q'),reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,timer=null,cur=0,TEXT='exam tomorrow, and I am anxious';
 function type(){clearInterval(timer);st.classList.remove('typed');q.textContent='';
  if(reduced){q.textContent=TEXT;st.classList.add('typed');return;}
  var i=0;timer=setInterval(function(){q.textContent=TEXT.slice(0,++i);if(i>=TEXT.length){clearInterval(timer);setTimeout(function(){if(cur===1)st.classList.add('typed');},180);}},55);}
 function go(n){if(n===cur)return;cur=n;st.setAttribute('data-step',n);steps.forEach(function(s){s.classList.toggle('on',+s.dataset.s===n);});if(n===1)type();}
 var mobile=matchMedia('(max-width:860px)');
 if(!mobile.matches){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)go(+e.target.dataset.s);});},{rootMargin:'-45% 0px -45% 0px'});
  steps.forEach(function(s){io.observe(s);});go(1);
 }else{
  /* phones: the steps play by themselves (a thin line under the open step shows the wait) until
     someone taps; then they lead. Tap a step to open it, or the stage to move on. */
  var loop=null,held=false,hw=st.parentNode;go(1);
  function play(){if(loop||held||reduced)return;hw.classList.add('auto');loop=setInterval(function(){go(cur%3+1);},4200);}
  function pause(){clearInterval(loop);loop=null;hw.classList.remove('auto');}
  function take(n){held=true;pause();go(n);}
  steps.forEach(function(s){s.setAttribute('role','button');s.setAttribute('tabindex','0');
   s.addEventListener('click',function(){take(+s.dataset.s);});
   s.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();take(+s.dataset.s);}});});
  st.addEventListener('click',function(){take(cur%3+1);});
  new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)play();else pause();});},{threshold:.4}).observe(st);
 }
})();
</script>

