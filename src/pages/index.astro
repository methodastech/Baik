<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Scheherazade+New:wght@500;700&display=swap" rel="stylesheet">
<script is:inline>/* the hero 3D deck is coming: keep the 2D fan hidden until it either arrives or fails (4 s) */
(function(){try{var c=document.createElement('canvas');if(!(c.getContext('webgl2')||c.getContext('webgl')))return;}catch(e){return;}
var r=document.documentElement;r.classList.add('d3-pending');setTimeout(function(){r.classList.remove('d3-pending');},4000);})();</script>
<Head />
</head>
<body>

<div class="loader" id="loader" aria-hidden="true">
  <span class="mark"><span class="baik-logo" role="img" aria-label="Baik"></span></span>
  <span class="bar"><i id="loadBar"></i></span>
  <span class="ct" id="loadCt">0</span>
</div>
<noscript></noscript>

<div class="atmo" id="atmo" aria-hidden="true"></div>
<div class="grain" aria-hidden="true"></div>
<div class="cur-ring" id="curRing" aria-hidden="true"></div>
<div class="cur-dot" id="curDot" aria-hidden="true"></div>
<div class="scroll-progress" aria-hidden="true"><span id="sprog"></span></div>

<header class="nav" id="nav">
  <a class="mark" href="#top"><span class="baik-logo" role="img" aria-label="Baik"></span></a>
  <nav class="nav-links" aria-label="Pages">
    <a href="/" aria-current="page" class="cur">Home</a>
  </nav>
  <a class="btn btn-gold" href="/khayr">Open the web app</a>
</header>

<main id="top">

<!-- ============ 1 · HERO ============ -->
<section class="hero">
  <div class="wrap hero-in">
    <div>
      <span class="k">Duas for every moment</span>
      <h1>Facing something?<br>There is a <span class="nw"><span class="g">dua</span> for it.</span></h1>
      <p class="lede">Baik is a card deck of authentic duas. Say what you are facing and draw the right card:
      the Arabic, how to say it, what it means, and exactly where it comes from. Nothing invented, every card sourced.</p>
      <div class="hero-cta">
        <a class="btn btn-gold" href="/khayr">Use Baik on the web · free</a>
        <a class="btn btn-line" href="#how">See how it works</a>
      </div>
      <p class="hero-note">Free forever. Every dua stays free; Premium only unlocks the tools around them.</p>
    </div>
    <div class="deck" id="deck" aria-label="Three dua cards from the deck">
      <div class="d3" id="d3"></div>
      <div class="mini m1" data-speed="0.06">
        <div class="mhead"><span class="mk">Dua · Protection</span><span class="pip"><i>01</i></span></div>
        <div class="mi"><canvas class="pcv mcv" data-scene="hizb" aria-hidden="true"></canvas>
          <span class="ms">Protection &amp; Ease</span>
          <span class="mt">Ayat al-Kursi</span>
          <span class="ar">ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ</span>
        </div>
        <div class="mfoot"><span>Protection Set</span><span>2:255</span></div>
      </div>
      <div class="mini m2" data-speed="-0.05">
        <div class="mhead"><span class="mk">Dua · Steadfastness</span><span class="pip"><i>02</i></span></div>
        <div class="mi"><canvas class="pcv mcv" data-scene="dua" aria-hidden="true"></canvas>
          <span class="ms">Forgiveness &amp; Mercy</span>
          <span class="mt">Steadfastness of Heart</span>
          <span class="ar">رَبَّنَا لَا تُزِغْ قُلُوبَنَا</span>
        </div>
        <div class="mfoot"><span>Gen Z Set</span><span>3:8</span></div>
      </div>
      <div class="mini m3" data-speed="0.1">
        <div class="mhead"><span class="mk">Dua · Travel</span><span class="pip"><i>01</i></span></div>
        <div class="mi"><canvas class="pcv mcv" data-scene="qibla" aria-hidden="true"></canvas>
          <span class="ms">Travel &amp; Visits</span>
          <span class="mt">Beginning a Journey</span>
          <span class="ar">بِسْمِ ٱللَّهِ مَجْرِىٰهَا</span>
        </div>
        <div class="mfoot"><span>Travel Set</span><span>11:41</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 4c · THE TABLE ============ -->
<section id="table">
  <div class="wrap facing-in">
    <div>
      <div class="sh" style="margin-bottom:0">
        <span class="k">The table</span>
        <h2 data-reveal>Set down what you are carrying.</h2>
        <p data-reveal data-reveal-delay="0.06">Money and a marriage. An exam and an anxious heart.
        Put the cubes for what you are facing on the table and Baik deals the cards that fit the
        combination, not just one of them. Saved cards stay where you leave them, like a spread you
        can come back to.</p>
      </div>
      <ul class="app-list" data-reveal data-reveal-delay="0.1">
        <li>Nine cubes: rizq, marriage, health, anxious heart, grief, travel, study, protection, forgiveness</li>
        <li>Combine any of them; the deal is scored across all of them</li>
        <li>Your own table remembers where every card lies</li>
      </ul>
    </div>
    <div data-reveal data-reveal-delay="0.08">
      <div class="t3-wrap"><div class="t3" id="t3"></div><figure class="shot t3-fallback"><img src="assets/site/table.webp" width="1365" height="805" loading="lazy" alt="The table view: saved cards lying at angles on the table, ready to drag and flip"></figure></div>
    </div>
  </div>
</section>

<hr class="divider" aria-hidden="true">

<!-- ============ 1b · THE OPEN MUSHAF (mushaf3d.js) ============ -->
<section class="mf" id="mushaf">
  <div class="wrap mf-in">
    <div>
      <span class="k">The surahs</span>
      <h2 data-reveal>Every page, a card you keep.</h2>
      <p class="mf-lp" data-reveal data-reveal-delay="0.06">Each surah card is set like a mushaf page: its name in the
      cartouche, the Arabic with its ayah marks, the meaning facing it with its source. Watch a page lift off the book as
      the card you carry in Baik, or drag a page across to turn it yourself.</p>
      <a class="btn btn-line" href="/khayr">See all 15 surah cards</a>
    </div>
    <div class="mf-wrap"><div class="mf-stage" id="mf3"></div></div>
  </div>
</section>

<!-- ============ 2 · SOURCES STRIP ============ -->
<div class="sources" aria-label="Where the duas come from">
  <div class="marquee">
    <div class="mq-track">
      <span class="mq-group">
        <span class="mq-item">Qur'an · Uthmani text</span><span class="mq-sep"></span>
        <span class="mq-item">Verified via Tanzil</span><span class="mq-sep"></span>
        <span class="mq-item">Sahih collections</span><span class="mq-sep"></span>
        <span class="mq-item">Source on every card</span><span class="mq-sep"></span>
        <span class="mq-item">Scholar review before release</span><span class="mq-sep"></span>
        <span class="mq-item">Nothing invented</span><span class="mq-sep"></span>
        <span class="mq-item">Every card cites its source</span><span class="mq-sep"></span>
        <span class="mq-item">No AI-written duas</span><span class="mq-sep"></span>
        <span class="mq-item">Free forever</span><span class="mq-sep"></span>
        </span>
      <span class="mq-group" aria-hidden="true">
        <span class="mq-item">Qur'an · Uthmani text</span><span class="mq-sep"></span>
        <span class="mq-item">Verified via Tanzil</span><span class="mq-sep"></span>
        <span class="mq-item">Sahih collections</span><span class="mq-sep"></span>
        <span class="mq-item">Source on every card</span><span class="mq-sep"></span>
        <span class="mq-item">Scholar review before release</span><span class="mq-sep"></span>
        <span class="mq-item">Nothing invented</span><span class="mq-sep"></span>
        <span class="mq-item">Every card cites its source</span><span class="mq-sep"></span>
        <span class="mq-item">No AI-written duas</span><span class="mq-sep"></span>
        <span class="mq-item">Free forever</span><span class="mq-sep"></span>
        </span>
    </div>
  </div>
</div>

<!-- ============ 4 · HOW IT WORKS ============ -->
<section id="how" class="how2">
  <div class="wrap">
    <div class="sh">
      <span class="k">How it works</span>
      <h2 data-reveal>Three moves, then you are reciting.</h2>
    </div>
    <div class="hw">
      <ol class="hw-steps">
        <li class="hw-step on" data-s="1"><span class="hw-n">01</span><div><h3>Say what you are facing</h3>
          <p>Search in your own words, tap a situation, or tick tags by set, kind and any of the 23 needs. Chosen tags sit under the field, and any one of them lifts off with a tap.</p></div></li>
        <li class="hw-step" data-s="2"><span class="hw-n">02</span><div><h3>Draw the card</h3>
          <p>Each dua is one card: the Arabic set like a mushaf page with its pause marks, the transliteration, and the meaning in plain words.</p></div></li>
        <li class="hw-step" data-s="3"><span class="hw-n">03</span><div><h3>Go deeper, or turn it over</h3>
          <p>Open <i>About this dua</i> for when it may be read and the story of its revelation. Turn the card over and the back is a plain deck back, the way a real card is. Save it, or share it with the source attached.</p></div></li>
      </ol>
      <div class="hw-stage" data-step="1" aria-hidden="true">
        <div class="hw-rail"><i></i></div>
        <div class="hw-search"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><span class="hw-q"></span><span class="hw-caret"></span></div>
        <div class="hw-tags"><span class="hw-tag">Study <b>×</b></span><span class="hw-tag">Anxiety <b>×</b></span><span class="hw-count">6 cards fit</span></div>
        <div class="hw-deck">
          <img class="hw-back b1" src="assets/site/card-back.webp" alt="" loading="lazy">
          <img class="hw-back b2" src="assets/site/card-back.webp" alt="" loading="lazy">
          <div class="hw-card"><div class="hw-flip"><img class="hw-front" src="assets/site/card-front.webp" alt="" loading="lazy"><img class="hw-rear" src="assets/site/card-back.webp" alt="" loading="lazy"></div></div>
        </div>
        <div class="hw-about"><span class="hw-ak">About this dua</span><b>When it may be read</b><span>Read when a decision is made and the outcome is no longer yours to hold.</span><b>Context of revelation</b><span>Part of the example set by Ibrahim and those with him, cited in al-Mumtahanah.</span></div>
        <div class="hw-acts"><span>☆ Save</span><span>Share</span><span>Read large</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 4b · THE SETS: scroll deals the deck ============ -->
<section id="sets">
  <div class="wrap">
    <div class="sh">
      <span class="k">The sets</span>
      <h2 data-reveal>Ten sets. Scroll to deal them.</h2>
      <p data-reveal data-reveal-delay="0.06">Every set has its own colour and its own ground to cover.
      Together they are one deck of 130 cards, filed across 23 needs, and growing.</p>
    </div>
    <div class="stack">
      <div class="scard" style="--i:0">
        <div><span class="sk">Set 01 · Doa Gen Z</span><h3>For the days that weigh on you.</h3>
        <p class="sd">Steadfastness of heart, pressure, sadness, a big decision, forgiveness. The duas for the life you are actually living.</p>
        <span class="sm">13 cards · blue suit</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="dua" aria-hidden="true"></canvas><span class="ar" lang="ar">رَبَّنَا لَا تُزِغْ قُلُوبَنَا</span></div>
      </div>
      <div class="scard" style="--i:1">
        <div><span class="sk">Set 02 · Doa Travel</span><h3>For every mile of the way.</h3>
        <p class="sd">Leaving home, boarding, the road, arrival, and the family left behind. A journey held from door to door.</p>
        <span class="sm">9 cards · rose suit</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="qibla" aria-hidden="true"></canvas><span class="ar" lang="ar">بِسْمِ ٱللَّهِ مَجْرِىٰهَا</span></div>
      </div>
      <div class="scard" style="--i:2">
        <div><span class="sk">Set 03 · Doa Rezeki</span><h3>For what you work for.</h3>
        <p class="sd">Mercy, a clean heart towards others, and the plea that your efforts are accepted. Provision asked for the right way round.</p>
        <span class="sm">4 cards · amber suit</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="masjid" aria-hidden="true"></canvas><span class="ar" lang="ar">رَبَّنَا تَقَبَّلْ مِنَّآ</span></div>
      </div>
      <div class="scard" style="--i:3">
        <div><span class="sk">Set 04 · Doa Protection</span><h3>For safety, seen and unseen.</h3>
        <p class="sd">Ayat al-Kursi, and the duas against slipping, against the Fire, and against becoming a trial for others.</p>
        <span class="sm">5 cards · emerald suit</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="shelter" aria-hidden="true"></canvas><span class="ar" lang="ar">ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ</span></div>
      </div>
      <div class="scard" style="--i:4">
        <div><span class="sk">Set 05 · Rabbana</span><h3>For when you say “our Lord”.</h3>
        <p class="sd">Twenty-two of the Qur’an’s own duas that open with Rabbana: patience, a family kept in prayer, reliance, a sorrow lifted.</p>
        <span class="sm">22 cards</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="rehal" aria-hidden="true"></canvas><span class="ar" lang="ar">رَبَّنَآ أَفْرِغْ عَلَيْنَا صَبْرًا</span></div>
      </div>
      <div class="scard" style="--i:5">
        <div><span class="sk">Set 06 · Kesihatan</span><h3>For the sick, and those sitting with them.</h3>
        <p class="sd">Ibrahim’s “when I am ill, He heals me”, Ayyub’s dua, and the ayat that name the Qur’an itself as healing.</p>
        <span class="sm">7 cards</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="sajadah" aria-hidden="true"></canvas><span class="ar" lang="ar">وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ</span></div>
      </div>
      <div class="scard" style="--i:6">
        <div><span class="sk">Set 07 · Surah</span><h3>For recitation itself.</h3>
        <p class="sd">Whole short surahs on near-black stock with gold rule, from Al-Fatihah to An-Nas: the illumination colours of a mushaf.</p>
        <span class="sm">15 cards · black stock</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="surah" aria-hidden="true"></canvas><span class="ar" lang="ar">قُلْ هُوَ ٱللَّهُ أَحَدٌ</span></div>
      </div>
      <div class="scard" style="--i:7">
        <div><span class="sk">Sets 08 & 09 · Panduan</span><h3>For the prayer and the fast.</h3>
        <p class="sd">Panduan Solat walks the prayer from its conditions to what to do when it goes wrong. Panduan Puasa covers intention, what breaks a fast, who is excused, and making days up.</p>
        <span class="sm">42 + 10 cards · Shafi’i, awaiting review</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="adhan" aria-hidden="true"></canvas></div>
      </div>
      <div class="scard" style="--i:8">
        <div><span class="sk">Set 10 · Zikir</span><h3>For the words that steady you.</h3>
        <p class="sd">Hasbunallah, the dua of Yunus in the dark, and what is said on hearing of a death. Each with its own counter.</p>
        <span class="sm">3 cards</span></div>
        <div class="sart live"><canvas class="pcv" data-scene="tasbih" aria-hidden="true"></canvas><span class="ar" lang="ar">حَسْبُنَا ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ</span></div>
      </div>
    </div>
  </div>
</section>

<hr class="divider" aria-hidden="true">

<!-- ============ 5 · FEATURES ============ -->
<section>
  <div class="wrap">
    <div class="sh">
      <span class="k">Built with care</span>
      <h2 data-reveal>Everything a dua needs.<br>Nothing it doesn't.</h2>
    </div>
    <div class="feats fxs">
      <div class="feat" data-reveal><div class="fx fx-src" aria-hidden="true"><div class="fx-card"><span class="fx-ar" lang="ar">رَبَّنَا هَبْ لَنَا مِنْ أَزْوَٰجِنَا</span><i class="fx-rule"></i><span class="fx-ref" data-type="Qur'an · Al-Furqan 25:74"></span><span class="fx-stamp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Verified · Tanzil</span></div></div>
        <h3>Authentic, cited, checked</h3><p>Qur'anic text transcribed from the Uthmani mushaf and verified. Every card names its surah, ayah or hadith source.</p></div>
      <div class="feat" data-reveal data-reveal-delay="0.05"><div class="fx fx-read" aria-hidden="true"><span class="fx-ar" lang="ar">رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً</span><span class="fx-seg"><b class="on">EN</b><b>BM</b><i></i></span><span class="fx-mean"><em class="on">“Our Lord, give us good in this world.”</em><em>“Ya Tuhan kami, berilah kami kebaikan di dunia.”</em></span></div>
        <h3>Read it your way</h3><p>Arabic with pause marks explained on hover, transliteration for learners, and the meaning in English or Bahasa Melayu: the toggle switches every card and label.</p></div>
      <div class="feat" data-reveal data-reveal-delay="0.1"><div class="fx fx-deck" aria-hidden="true"><i class="fx-c c1"></i><i class="fx-c c2"></i><i class="fx-c c3"><span>Baik</span></i><i class="fx-mark"></i></div>
        <h3>Your own deck</h3><p>Save the duas you return to. A daily featured dua keeps one card on your table every morning.</p></div>
      <div class="feat" data-reveal data-reveal-delay="0.05"><div class="fx fx-share" aria-hidden="true"><div class="fx-bub"><span class="fx-ar" lang="ar">رَبِّ زِدْنِي عِلْمًا</span><span class="fx-en">“My Lord, increase me in knowledge.”</span><span class="fx-ref2">Qur'an · Ta-Ha 20:114 · shared from Baik</span><span class="fx-tick">✓✓</span></div></div>
        <h3>Share with the source</h3><p>Copy or share any card to WhatsApp, Telegram or anywhere. The reference travels with it, always.</p></div>
      <div class="feat" data-reveal data-reveal-delay="0.1"><div class="fx fx-hear" aria-hidden="true"><span class="fx-ar fx-words" lang="ar"><b>حَسْبُنَا</b> <b>ٱللَّهُ</b> <b>وَنِعْمَ</b> <b>ٱلْوَكِيلُ</b></span><span class="fx-wave"><i style="--k:0;height:6px"></i><i style="--k:1;height:24px"></i><i style="--k:2;height:23px"></i><i style="--k:3;height:22px"></i><i style="--k:4;height:21px"></i><i style="--k:5;height:20px"></i><i style="--k:6;height:19px"></i><i style="--k:7;height:18px"></i><i style="--k:8;height:17px"></i><i style="--k:9;height:16px"></i><i style="--k:10;height:15px"></i><i style="--k:11;height:14px"></i><i style="--k:12;height:13px"></i><i style="--k:13;height:12px"></i><i style="--k:14;height:11px"></i><i style="--k:15;height:10px"></i><i style="--k:16;height:9px"></i><i style="--k:17;height:8px"></i><i style="--k:18;height:7px"></i><i style="--k:19;height:6px"></i><i style="--k:20;height:24px"></i><i style="--k:21;height:23px"></i><i style="--k:22;height:22px"></i><i style="--k:23;height:21px"></i><i style="--k:24;height:20px"></i><i style="--k:25;height:19px"></i><i style="--k:26;height:18px"></i><i style="--k:27;height:17px"></i></span></div>
