<script is:inline defer>
(function(){
'use strict';
var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- sticky nav ---------- */
var nav=document.getElementById('nav'),solid=false;
function navUpd(){var s=window.scrollY>24;if(s!==solid){solid=s;nav.classList.toggle('is-solid',s);}}
window.addEventListener('scroll',navUpd,{passive:true});navUpd();

/* ---------- preloader: fast, honest, impossible to strand ----------
   Counts while fonts load, lifts on fonts.ready, and a hard 1.8s timeout lifts it
   no matter what. Reduced motion never sees it (CSS display:none). */
(function(){
 var el=document.getElementById('loader');if(!el)return;
 try{if(sessionStorage.getItem('baik.seen')){el.classList.add('done');return;}sessionStorage.setItem('baik.seen','1');}catch(e){}
 var ct=document.getElementById('loadCt'),bar=document.getElementById('loadBar');
 var p=0,done=false,tick=setInterval(function(){
  p=Math.min(p+Math.random()*22,96);
  ct.textContent=Math.round(p);bar.style.transform='scaleX('+(p/100)+')';
 },90);
 function lift(){
  if(done)return;done=true;clearInterval(tick);
  ct.textContent='100';bar.style.transform='scaleX(1)';
  setTimeout(function(){el.classList.add('done');},180);
 }
 if(document.fonts&&document.fonts.ready)document.fonts.ready.then(lift);
 window.addEventListener('load',lift);
 setTimeout(lift,1800);   /* the hard failsafe */
})();

/* ---------- custom cursor: dot at the point, ring on a lag ---------- */
(function(){
 if(reduced||!window.matchMedia('(hover:hover) and (pointer:fine)').matches)return;
 var dot=document.getElementById('curDot'),ring=document.getElementById('curRing');
 if(!dot||!ring)return;
 document.body.classList.add('has-cursor');
 var x=-100,y=-100,rx=-100,ry=-100,seen=false;
 document.addEventListener('mousemove',function(e){x=e.clientX;y=e.clientY;seen=true;},{passive:true});
 (function loop(){
  rx+=(x-rx)*.16;ry+=(y-ry)*.16;
  if(seen){dot.style.transform='translate('+x+'px,'+y+'px) translate(-50%,-50%)';
   ring.style.transform='translate('+rx+'px,'+ry+'px) translate(-50%,-50%)';}
  requestAnimationFrame(loop);
 })();
 document.addEventListener('mouseover',function(e){
  ring.classList.toggle('big',!!(e.target.closest&&e.target.closest('a,button,summary,input,.fchip,.mini')));
 });
})();

/* ---------- magnetic buttons: the gold ones lean toward the hand ---------- */
(function(){
 if(reduced||!window.matchMedia('(hover:hover) and (pointer:fine)').matches)return;
 document.querySelectorAll('.btn-gold').forEach(function(b){
  b.addEventListener('mousemove',function(e){
   var r=b.getBoundingClientRect();
   var dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);
   b.style.transform='translate('+dx*.18+'px,'+dy*.3+'px)';
  });
  b.addEventListener('mouseleave',function(){b.style.transform='';});
 });
})();

/* ---------- gold progress hairline ---------- */
var sprog=document.getElementById('sprog');
function progUpd(){
 var max=document.documentElement.scrollHeight-window.innerHeight;
 sprog.style.transform='scaleX('+(max>0?window.scrollY/max:0)+')';
}
window.addEventListener('scroll',progUpd,{passive:true});progUpd();

/* ---------- the hero fan leans toward the pointer (fine pointers only) ---------- */
(function(){
 if(reduced||!window.matchMedia('(hover:hover) and (pointer:fine)').matches)return;
 var deck=document.getElementById('deck'),hero=document.querySelector('.hero-in');
 if(!deck||!hero)return;
 hero.addEventListener('mousemove',function(e){
  if(deck.classList.contains('gl'))return;
  var r=deck.getBoundingClientRect();
  var dx=(e.clientX-(r.left+r.width/2))/r.width, dy=(e.clientY-(r.top+r.height/2))/r.height;
  deck.style.transform='rotateY('+(dx*7)+'deg) rotateX('+(dy*-7)+'deg)';
 });
 hero.addEventListener('mouseleave',function(){deck.style.transform='';});
})();

/* ---------- toast ---------- */
function toast(m){var t=document.getElementById('toast');t.textContent=m;t.classList.add('on');
 clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('on');},2400);}

/* ---------- "what are you facing" demo: chips swap the card ---------- */
var FACES=[
 {n:'Exam tomorrow',k:'Dua · Guidance',t:'Seeking Wisdom & Mercy',
  ar:'رَبِّ هَبْ لِي حُكْمًا وَأَلْحِقْنِي بِالصَّالِحِينَ',
  en:'“My Lord, grant me wisdom and join me with the righteous.”',s:"Qur'an · Ash-Shu'ara 26:83"},
 {n:'Travelling',k:'Dua · Travel',t:'Beginning a Journey',
  ar:'بِسْمِ ٱللَّهِ مَجْرِىٰهَا وَمُرْسَىٰهَآ',
  en:'“In the name of Allah is its course and its anchorage.”',s:"Qur'an · Hud 11:41"},
 {n:'Feeling anxious',k:'Dua · Ease',t:'An Opened Chest',
  ar:'رَبِّ اشْرَحْ لِي صَدْرِي وَيَسِّرْ لِي أَمْرِي',
  en:'“My Lord, expand for me my chest, and ease for me my task.”',s:"Qur'an · Ta-Ha 20:25-26"},
 {n:'A heavy heart',k:'Dua · Steadfastness',t:'Steadfastness of Heart',
  ar:'رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا',
  en:'“Our Lord, let not our hearts deviate after You have guided us.”',s:"Qur'an · Ali 'Imran 3:8"},
 {n:'Family conflict',k:'Dua · Family',t:'Comfort of the Eyes',
  ar:'رَبَّنَا هَبْ لَنَا مِنْ أَزْوَٰجِنَا وَذُرِّيَّـٰتِنَا قُرَّةَ أَعْيُنٍ',
  en:'“Our Lord, grant us from our spouses and offspring comfort to our eyes.”',s:"Qur'an · Al-Furqan 25:74"},
 {n:'Seeking forgiveness',k:'Dua · Mercy',t:'Complete Reliance',
  ar:'رَبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا',
  en:'“Our Lord, upon You we rely, and to You we return.”',s:"Qur'an · Al-Mumtahanah 60:4"}
];
var chipsEl=document.getElementById('fchips'),card=document.getElementById('fcard'),cur=0,busy=false;
FACES.forEach(function(f,i){
 var b=document.createElement('button');b.className='fchip'+(i===0?' on':'');b.textContent=f.n;
 b.addEventListener('click',function(){pick(i,b);});chipsEl.appendChild(b);
});
function setCard(f){
 document.getElementById('fcK').textContent=f.k;
 document.getElementById('fcT').textContent=f.t;
 document.getElementById('fcA').textContent=f.ar;
 document.getElementById('fcE').textContent=f.en;
 document.getElementById('fcS').textContent=f.s;
}
function pick(i,btn){
 if(busy||i===cur)return;busy=true;cur=i;
 chipsEl.querySelectorAll('.fchip').forEach(function(c){c.classList.remove('on');});
 btn.classList.add('on');
 if(reduced){setCard(FACES[i]);busy=false;return;}
 card.classList.add('swap');
 setTimeout(function(){setCard(FACES[i]);card.classList.remove('swap');busy=false;},230);
}

/* ---------- leads: kept locally, exportable, honest about having no backend ----------
   Nothing is sent anywhere. The list lives in this browser until a backend exists, and
   the page says so rather than implying a signup happened. */
function leadAdd(email,source){
 var list=[];
 try{list=JSON.parse(localStorage.getItem('baik.leads')||'[]');}catch(e){}
 if(list.some(function(l){return l.e===email;}))return 'dupe';
 list.push({e:email,s:source,at:Date.now()});
 try{localStorage.setItem('baik.leads',JSON.stringify(list));}catch(e){}
 return list.length;
}
function leadWire(form,input,source,okMsg){
 if(!form)return;
 form.addEventListener('submit',function(e){
  e.preventDefault();
  var v=input.value.trim();
  if(!/^\S+@\S+\.\S+$/.test(v)){toast('That email does not look right.');return;}
  var r=leadAdd(v,source);
  input.value='';
  toast(r==='dupe'?'You are already on the list.':okMsg);
 });
}

/* ---------- waitlist: honest stub until a backend exists ---------- */
leadWire(document.getElementById('waitForm'),document.getElementById('waitMail'),'app-waitlist',
 'You are on the list. We will write once, when the app lands.');
leadWire(document.getElementById('qtForm'),document.getElementById('qtMail'),'qibla-times',
 'You are on the list. We will write once, when the app lands.');
leadWire(document.getElementById('dailyForm'),document.getElementById('dailyMail'),'daily-dua',
 'Noted. One dua a morning, nothing else, and you can stop any time.');

/* ---------- social profiles: named, not yet open ---------- */
document.querySelectorAll('.soc').forEach(function(b){
 b.addEventListener('click',function(){toast(b.dataset.soc+' opens with the app launch.');});
});

/* ---------- share ---------- */
var URLS=function(){var u=encodeURIComponent(location.href.split('#')[0]);
 var m=encodeURIComponent('Baik · the right dua for what you are facing. Free on the web: ');
 return {wa:'https://wa.me/?text='+m+u,tg:'https://t.me/share/url?url='+u+'&text='+m,
  x:'https://twitter.com/intent/tweet?text='+m+'&url='+u};}();
document.getElementById('shWa').href=URLS.wa;
document.getElementById('shTg').href=URLS.tg;
document.getElementById('shX').href=URLS.x;
document.getElementById('shCopy').addEventListener('click',function(){
 var u=location.href.split('#')[0];
 if(navigator.clipboard)navigator.clipboard.writeText(u).then(function(){toast('Link copied.');},function(){toast(u);});
 else toast(u);
});

/* ---------- marquee speed normalised to content width ---------- */
function mq(){var tr=document.querySelector('.mq-track');if(!tr||!tr.firstElementChild)return;
 var w=tr.firstElementChild.offsetWidth;if(w>0)tr.style.animationDuration=(w/60)+'s';}
mq();if(document.fonts&&document.fonts.ready)document.fonts.ready.then(mq);
window.addEventListener('resize',mq);

/* ---------- GSAP layer (page fully readable without it) ---------- */
var hasGSAP=typeof window.gsap!=='undefined'&&typeof window.ScrollTrigger!=='undefined';
if(!hasGSAP||reduced)return;
gsap.registerPlugin(ScrollTrigger);

/* Lenis: the weighted scroll every current award winner shares. Wired the one safe
   way: one rAF loop through GSAP's ticker, ScrollTrigger updated from Lenis, native
   smooth-behavior turned off so nothing double-eases. Absent or failed, native scroll
   simply remains. */
if(typeof window.Lenis!=='undefined'){
 try{
  var lenis=new Lenis({duration:1.05,easing:function(t){return 1-Math.pow(1-t,3);}});
  lenis.on('scroll',ScrollTrigger.update);
  gsap.ticker.add(function(time){lenis.raf(time*1000);});
  gsap.ticker.lagSmoothing(0);
  document.documentElement.style.scrollBehavior='auto';
 }catch(e){}
}

/* reveals: immediateRender:false so a missed trigger never hides content */
var revealEls=gsap.utils.toArray('[data-reveal]');
var fired=new WeakSet();
revealEls.forEach(function(el){
 var d=parseFloat(el.getAttribute('data-reveal-delay'))||0;
 gsap.from(el,{opacity:0,y:26,duration:.85,delay:d,ease:'power3.out',immediateRender:false,
  scrollTrigger:{trigger:el,start:'top 88%',once:true,onEnter:function(){fired.add(el);}}});
});
window.addEventListener('load',function(){
 ScrollTrigger.refresh();
 revealEls.forEach(function(el){
  if(!fired.has(el)&&el.getBoundingClientRect().top<window.innerHeight)
   gsap.set(el,{clearProps:'opacity,transform'});
 });
});

/* split-text hero: words rise out of their own clips. The CSS blur intro is
   dropped only when this richer entrance actually takes over. */
(function(){
 var h=document.querySelector('.hero h1');if(!h)return;
 function wrapWords(node){
  [].slice.call(node.childNodes).forEach(function(n){
   if(n.nodeType===3){
    var frag=document.createDocumentFragment();
    n.textContent.split(/(\s+)/).forEach(function(part){
     if(!part)return;
     if(/^\s+$/.test(part)){frag.appendChild(document.createTextNode(part));return;}
     var w=document.createElement('span');w.className='w';
     var wi=document.createElement('span');wi.className='wi';wi.textContent=part;
     w.appendChild(wi);frag.appendChild(w);
    });
    node.replaceChild(frag,n);
   }else if(n.nodeType===1&&n.tagName!=='BR')wrapWords(n);
  });
 }
 wrapWords(h);
 h.style.animation='none';
 var chunks=h.querySelectorAll('.wi');
 gsap.set(chunks,{yPercent:115});
 gsap.to(chunks,{yPercent:0,duration:.95,ease:'expo.out',stagger:.055,delay:.55});
 /* if the tween is ever interrupted, the words must still stand */
 setTimeout(function(){gsap.set(chunks,{clearProps:'transform'});},2600);
})();

/* the kinetic strip is dragged by the scrollbar, outline ink over the field */
gsap.to('#kinetic',{xPercent:-28,ease:'none',
 scrollTrigger:{trigger:'.kinetic',start:'top bottom',end:'bottom top',scrub:.6,invalidateOnRefresh:true}});

/* hero deck parallax: gentle drift per data-speed, desktop only */
if(window.matchMedia('(min-width: 901px)').matches){
 gsap.utils.toArray('.mini[data-speed]').forEach(function(el){
  var sp=parseFloat(el.getAttribute('data-speed'))||0;
  gsap.to(el,{yPercent:sp*160,ease:'none',
   scrollTrigger:{trigger:'#deck',start:'top bottom',end:'bottom top',scrub:.5,invalidateOnRefresh:true}});
 });
}

/* count-up stats */
gsap.utils.toArray('[data-countup]').forEach(function(el){
 var target=parseFloat(el.getAttribute('data-countup'))||0,obj={v:0};
 ScrollTrigger.create({trigger:el,start:'top 88%',once:true,onEnter:function(){
  gsap.to(obj,{v:target,duration:1.3,ease:'power2.out',
   onUpdate:function(){el.textContent=Math.round(obj.v);},
   onComplete:function(){el.textContent=target;}});
 }});
});

if(document.fonts&&document.fonts.ready)document.fonts.ready.then(function(){ScrollTrigger.refresh();});
})();
</script>
