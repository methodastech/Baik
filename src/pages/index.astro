<!doctype html>
<html lang="en">
<head>
<link rel="stylesheet" href="/css/site.css">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Baik · The right dua for what you are facing</title>
<meta name="description" content="Baik is a dua card deck. Say what you are facing and draw the right dua: Arabic, transliteration, meaning and source, on one beautiful card. Free forever on the web, app coming soon.">
<meta property="og:title" content="Baik · The right dua for what you are facing">
<meta property="og:description" content="A card deck of authentic duas. Free forever on the web, app coming soon.">
<meta property="og:type" content="website">
<!-- og:image · VISUAL NEEDED: 1200x630 social card. The Baik wordmark in gold on the deep
     emerald field, three dua cards fanned to the right, tagline under the mark. Export PNG,
     under 300KB, then point this tag at its URL. -->
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="/">
<meta property="og:url" content="/">
