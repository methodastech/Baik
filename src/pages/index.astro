  var r=0;timers.push(setInterval(function(){r=(r+1)%seg.length;seg.forEach(function(b,i){b.classList.toggle('on',i===r);});mean.forEach(function(e,i){e.classList.toggle('on',i===r);});box.style.setProperty('--seg',r);},2600));
