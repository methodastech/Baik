  // 1 · the source types itself, then the check stamps in; again every few seconds
  every(6200,function(){box.classList.remove('typed');ref.textContent='';var t=ref.dataset.type,i=0;
   var k=setInterval(function(){ref.textContent=t.slice(0,++i);if(i>=t.length){clearInterval(k);setTimeout(function(){box.classList.add('typed');},220);}},48);timers.push(k);});
