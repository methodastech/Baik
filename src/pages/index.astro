/* ---------- "Built with care": each tile shows what it says, quietly, while on screen ---------- */
(function(){
 var box=document.querySelector('.feats.fxs');if(!box)return;
 var reduced=matchMedia('(prefers-reduced-motion: reduce)').matches,timers=[],on=false;
 var ref=box.querySelector('.fx-ref'),seg=box.querySelectorAll('.fx-seg b'),mean=box.querySelectorAll('.fx-mean em'),words=box.querySelectorAll('.fx-words b');
 function every(ms,fn){fn();timers.push(setInterval(fn,ms));}
 function start(){
  if(on)return;on=true;box.classList.add('play');
