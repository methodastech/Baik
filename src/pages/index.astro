<script is:inline>
/* particle scenes: the showcase switches on a tap and turns by itself until touched;
   each set panel mounts its own scene at half rate (only on-screen canvases draw) */
(function(){
  if(!window.BaikParticles)return;
  var P=window.BaikParticles, reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var reducedP=reduced;   /* the old showcase is gone; the set panels still mount their scenes */
  document.querySelectorAll('canvas.pcv[data-scene]').forEach(function(c,i){
    P.mount(c,c.dataset.scene,{half:1+i%2,zoom:1.05,hoverEl:c.closest('.scard')||c.parentElement});
  });
})();
</script>
