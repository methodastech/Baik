<!doctype html>
<html lang="en">
<head>
<link rel="stylesheet" href="/css/card-back.css">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Baik · Card Back</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<header><h1>Baik · card back</h1><span class="sub">one drawing, two inks — the same plate prints the surah and the dua</span></header>
<div class="spec">630 × 1010 · Rub el Hizb over an astrolabe · dotted medallion · double frame, knot corners · paper grain · the wordmark is the Baik logo itself (assets/logo)</div>
<div class="ctl">
 <label>surah <input type="text" id="k1" value="SURAH 113 · 5 AYAT · MAKKAN" class="w" placeholder="kicker"> <input type="text" id="t1" value="Al-Falaq · The Daybreak" class="w" placeholder="title"> <input type="text" id="s1" value="" placeholder="source (none)"> <input type="text" id="c1" value="GZ-07" style="width:80px"></label>
</div>
<div class="ctl">
 <label>dua <input type="text" id="k2" value="DUA · KNOWLEDGE & STUDY" class="w" placeholder="kicker"> <input type="text" id="t2" value="Opening the Heart & Easing Speech" class="w" placeholder="title"> <input type="text" id="s2" value="Qur'an · Taha 20:25–28" placeholder="source"> <input type="text" id="c2" value="PR-04" style="width:80px"></label>
</div>
<div class="ctl">
 <label>set <input type="text" id="set" value="SET 01"></label>
 <label><input type="checkbox" id="grain" checked> grain</label>
</div>
<h2 class="sec" id="cnh">Corner designs <span>pick one — it goes to the four corners of the plate</span></h2>
<div class="corners" id="corners"></div>
<h2 class="sec">All backs <span>every design, both stocks, side by side</span></h2>
<div class="row" id="row"></div>

<script is:inline id="gen">
/* ====================== the plate ======================
   Everything is drawn about the centre C on a 630 × 1010 card. Radii below are proportions of
   the reference measured off the screenshot, not eyeballed: the outer star reaches 89% of the
   half-width, the medallion is a third of that, the tick ring sits just past the frame so the
   frame clips it, which is what makes the rings feel like they continue under the border. */
var W=630,H=1010,CX=315,CY=505;
/* default frame insets: heavy rule, then the hairline 12 inside it. A corner design may override them. */
var FO=26,FI=38;
function f(n){return Math.round(n*100)/100;}
function P(r,a){var t=(a-90)*Math.PI/180;return [f(CX+r*Math.cos(t)),f(CY+r*Math.sin(t))];}
function poly(pts){return pts.map(function(p){return p[0]+','+p[1];}).join(' ');}
/* two concentric squares, one turned 45°, share a circumradius R. Their union is the
   8-point star: tips at every 45°, inner vertices between them at R·cos45/cos22.5. */
function starOutline(R){var pts=[],i;for(i=0;i<8;i++){pts.push(P(R,i*45));pts.push(P(R*0.7654,i*45+22.5));}return pts;}
function square(R,turn){var pts=[],i;for(i=0;i<4;i++)pts.push(P(R,turn+i*90));return pts;}
function diamond(x,y,s){return (x)+','+(y-s)+' '+(x+s)+','+(y)+' '+(x)+','+(y+s)+' '+(x-s)+','+(y);}
/* ====================== CORNER LIBRARY ======================
   Every corner design is one entry here. It is drawn ONCE, for the top-left corner, in card
   coordinates — the inner rule's corner is at (FI,FI), the outer rule's at (FO,FO) — and the
   plate mirrors it to the other three. Each entry says:
     name     what the gallery calls it
     chamfer  how far along each edge the inner rule is cut at 45° (0 = keep the round corner)
     frame    optional {fo, fi, double}: insets for the heavy rule, the hairline, and a second thin rule
     draw     (ink, faint, paper, fr) → svg markup for the top-left corner only; fr is {fo, fi} in use
   Add a design by adding an entry. Nothing else needs to change. */
var CORNERS={
 knot:{name:'Mamluk knot',ref:true,chamfer:36,draw:function(ink,faint,paper){
  /* A square knot straddling a short chamfer, its outer loop just inside the heavy rule. The
     knot is WOVEN, not stacked: two squares, one turned, pass over and under each other. Each
     band that goes over is redrawn last with a halo of paper under it, which breaks the band
     beneath — the way an engraver does it. */
  var cx=62,cy=62,h=22,t=h*1.16,o='',halo=' stroke="'+paper+'" stroke-width="5.2"';
  var A='<rect x="'+(-h)+'" y="'+(-h)+'" width="'+(2*h)+'" height="'+(2*h)+'"/>';
  var B='<rect x="'+(-t*.7071)+'" y="'+(-t*.7071)+'" width="'+(t*1.4142)+'" height="'+(t*1.4142)+'" transform="rotate(45)"/>';
  var Atb='<path d="M'+(-h)+' '+(-h)+'H'+h+'M'+(-h)+' '+h+'H'+h+'"/>';
  o+='<g fill="none" stroke="'+ink+'" stroke-width="1.9" stroke-linejoin="miter" transform="translate('+cx+' '+cy+')">';
  o+=A;o+='<g'+halo+'>'+B+'</g>'+B;o+='<g'+halo+'>'+Atb+'</g>'+Atb;
  o+='<rect x="'+(-h*.3)+'" y="'+(-h*.3)+'" width="'+(h*.6)+'" height="'+(h*.6)+'" transform="rotate(45)" stroke-width="1.4"/>';
  o+='<circle r="'+(h*.15)+'" stroke-width="1.4"/><circle r="1.7" fill="'+ink+'" stroke="none"/>';
  [[-1,-1],[1,-1],[1,1],[-1,1]].forEach(function(d){var x=d[0]*h,y=d[1]*h,r=h*.19;
   o+='<rect x="'+(x-r)+'" y="'+(y-r)+'" width="'+(2*r)+'" height="'+(2*r)+'" transform="rotate(45 '+x+' '+y+')" fill="'+paper+'" stroke-width="1.5"/>';});
  o+='</g>';
  o+='<line x1="30" y1="30" x2="'+(cx-h)+'" y2="'+(cy-h)+'" stroke="'+ink+'" stroke-width="1.6"/>';
  return o;}},
 knot2:{name:'Corner knot · double rule',ref:true,chamfer:65,frame:{fo:18,fi:40,double:27},draw:function(ink,faint,paper,fr){
  /* From the close crop of the printed card. Three rules, not two: the heavy one at 18, a thin
     one 9 inside it, then the hairline at 40. The hairline's corner is cut by ONE long diagonal,
     65 units, that runs from the left hairline up to the top hairline and passes UNDER the knot.
     The knot fills the pocket that leaves: a square band, 44 across, seated from 40 to 84 —
     outer corner tied to the heavy rule's corner, inner corner just past the diagonal. A second
     band runs inside the first; a ring at the heart holds a turned square and a dot; at each
     outer corner the band turns through a small square loop. */
  var cx=62,cy=62,h=22,o='';
  o+='<rect x="'+(cx-h+2)+'" y="'+(cy-h+2)+'" width="'+(2*h-4)+'" height="'+(2*h-4)+'" fill="'+paper+'"/>';
  o+='<g fill="none" stroke="'+ink+'" stroke-width="1.8" stroke-linejoin="miter" transform="translate('+cx+' '+cy+')">';
  o+='<rect x="'+(-h)+'" y="'+(-h)+'" width="'+(2*h)+'" height="'+(2*h)+'"/>';
  o+='<rect x="'+(-h+6.5)+'" y="'+(-h+6.5)+'" width="'+(2*h-13)+'" height="'+(2*h-13)+'" stroke-width="1.3"/>';
  o+='<circle r="'+(h*.42)+'" stroke-width="1.5"/>';
  o+='<rect x="-5" y="-5" width="10" height="10" transform="rotate(45)" stroke-width="1.3"/>';
  o+='<circle r="1.5" fill="'+ink+'" stroke="none"/>';
  [[-1,-1],[1,-1],[1,1],[-1,1]].forEach(function(d){var x=d[0]*h,y=d[1]*h;
   o+='<rect x="'+(x-5)+'" y="'+(y-5)+'" width="10" height="10" fill="'+paper+'" stroke-width="1.5"/>';});
  o+='</g>';
  o+='<line x1="'+(fr.fo+4)+'" y1="'+(fr.fo+4)+'" x2="'+(cx-h)+'" y2="'+(cy-h)+'" stroke="'+ink+'" stroke-width="1.6"/>';
  return o;}},
 chamfer:{name:'Chamfer only',chamfer:54,draw:function(ink){
  return '<polygon points="'+diamond(66,66,6)+'" fill="'+ink+'"/>';}},
 plain:{name:'Plain round',chamfer:0,draw:function(){return '';}},
 bracket:{name:'Bracket',chamfer:0,draw:function(ink){
  return '<path d="M50 50h44M50 50v44M58 58h28M58 58v28" fill="none" stroke="'+ink+'" stroke-width="1.8"/><circle cx="50" cy="50" r="3.2" fill="'+ink+'"/>';}}
};
/* the four corners of a card from one drawing: mirror across the card's axes */
function corners(key,ink,faint,paper,fr){var c=CORNERS[key]||CORNERS.knot,d=c.draw(ink,faint,paper,fr||{fo:FO,fi:FI});if(!d)return '';
 return '<g>'+d+'</g><g transform="translate('+W+' 0) scale(-1 1)">'+d+'</g><g transform="translate(0 '+H+') scale(1 -1)">'+d+'</g><g transform="translate('+W+' '+H+') scale(-1 -1)">'+d+'</g>';}
/* the inner rule, cut at the corners by the chosen design */
function innerRule(c,i){i=i||FI;var r=10;if(!c)return '<rect x="'+i+'" y="'+i+'" width="'+(W-2*i)+'" height="'+(H-2*i)+'" rx="'+r+'"/>';
 return '<path d="M'+(i+c)+' '+i+'H'+(W-i-c)+'L'+(W-i)+' '+(i+c)+'V'+(H-i-c)+'L'+(W-i-c)+' '+(H-i)+'H'+(i+c)+'L'+i+' '+(H-i-c)+'V'+(i+c)+'Z"/>';}

function plateSVG(o){
 var dark=!!o.dark, id=o.id||'b';
 /* the corner design may bring its own frame: insets for the heavy rule and hairline, and an optional second thin rule */
 var CD=CORNERS[o.corner]||CORNERS.knot,FR=CD.frame||{},fo=FR.fo||FO,fi=FR.fi||FI;
 var paper=dark?'#0F1012':'#F5F4F1', rim=dark?'#E8E7E3':'#FFFFFF', ink=dark?'#F3F2EE':'#151618';
 var faint=dark?'rgba(243,242,238,.42)':'rgba(21,22,24,.42)';
 var ghost=dark?'rgba(243,242,238,.18)':'rgba(21,22,24,.18)';
 var facet=dark?'rgba(243,242,238,.07)':'rgba(21,22,24,.06)';
 var facet2=dark?'rgba(243,242,238,.05)':'rgba(21,22,24,.045)';
 var s='';
 s+='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 '+W+' '+H+'" font-family="\'JetBrains Mono\',ui-monospace,monospace">';
 s+='<defs>';
 s+='<clipPath id="'+id+'-in">'+innerRule(CD.chamfer,fi)+'</clipPath>';
 s+='<clipPath id="'+id+'-card"><rect x="0" y="0" width="'+W+'" height="'+H+'" rx="28"/></clipPath>';
 /* grain: turbulence mapped to alpha only, coloured to the ink, so it is speckle not colour */
 s+='<filter id="'+id+'-grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="'+(dark?7:3)+'" stitchTiles="stitch"/>'
  +'<feColorMatrix values="0 0 0 0 '+(dark?1:0)+'  0 0 0 0 '+(dark?1:0)+'  0 0 0 0 '+(dark?1:0)+'  0 0 0 '+(dark?'.34':'.22')+' 0"/></filter>';
 s+='<linearGradient id="'+id+'-gloss" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="'+(dark?'.16':'.55')+'"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/></linearGradient>';
 s+='<radialGradient id="'+id+'-vig" cx=".5" cy=".5" r=".75"><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="'+(dark?'.55':'.10')+'"/></radialGradient>';
 s+='</defs>';
 /* stock, then the printed field inside its paper rim */
 s+='<rect width="'+W+'" height="'+H+'" rx="28" fill="'+rim+'"/>';
 s+='<rect x="8" y="8" width="'+(W-16)+'" height="'+(H-16)+'" rx="22" fill="'+paper+'"/>';
 /* ---- astrolabe, clipped to the inner frame ---- */
 /* Read off the reference: the outer star is two EQUAL squares, one turned 45° (R1); a second,
    smaller pair sits inside it (R2 = 0.6 R1). Between them the band is cut into sixteen facets
    by lines joining matching vertices of the two outlines, tinted alternately — that lattice is
    the relief the reference has. The medallion's dotted ring touches the inner square's sides. */
 var R1=280,R2=170,OUT=starOutline(R1),INN=starOutline(R2);
 s+='<g clip-path="url(#'+id+'-in)">';
 var i,a;
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="351" fill="none" stroke="'+ghost+'" stroke-width="1.2"/>';
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="293" fill="none" stroke="'+faint+'" stroke-width="1.5"/>';
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="232" fill="none" stroke="'+faint+'" stroke-width="1.3" stroke-dasharray="1.6 5.2"/>';
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="205" fill="none" stroke="'+ghost+'" stroke-width="1" stroke-dasharray="2 6"/>';
 /* ticks outward from the great ring: every 3°, long every 15° */
 s+='<g stroke="'+faint+'" stroke-width="1.2">';
 for(i=0;i<120;i++){a=i*3;var len=(i%5===0)?16:8;var p1=P(293,a),p2=P(293+len,a);s+='<line x1="'+p1[0]+'" y1="'+p1[1]+'" x2="'+p2[0]+'" y2="'+p2[1]+'"/>';}
 s+='</g>';
 /* minor spokes every 15°, medallion to ring, under the stars */
 s+='<g stroke="'+ghost+'" stroke-width="1">';
 for(i=0;i<24;i++){a=i*15;if(a%45===0)continue;var q1=P(126,a),q2=P(293,a);s+='<line x1="'+q1[0]+'" y1="'+q1[1]+'" x2="'+q2[0]+'" y2="'+q2[1]+'"/>';}
 s+='</g>';
 /* the star's field, then the sixteen facets of the band, alternating */
 s+='<polygon points="'+poly(OUT)+'" fill="'+facet2+'"/>';
 for(i=0;i<16;i++){var o1=OUT[i],o2=OUT[(i+1)%16],i1=INN[i],i2=INN[(i+1)%16];
  s+='<polygon points="'+o1[0]+','+o1[1]+' '+o2[0]+','+o2[1]+' '+i2[0]+','+i2[1]+' '+i1[0]+','+i1[1]+'" fill="'+(i%2?facet:'none')+'"/>';}
 s+='<polygon points="'+poly(INN)+'" fill="'+facet2+'"/>';
 /* a ghost star midway through the band cuts each facet in two: the reference's lattice */
 s+='<g fill="none" stroke="'+ghost+'" stroke-width="1"><polygon points="'+poly(square(225,0))+'"/><polygon points="'+poly(square(225,45))+'"/></g>';
 /* lattice seams: each outer vertex to its inner twin */
 s+='<g stroke="'+ghost+'" stroke-width="1">';
 for(i=0;i<16;i++){s+='<line x1="'+OUT[i][0]+'" y1="'+OUT[i][1]+'" x2="'+INN[i][0]+'" y2="'+INN[i][1]+'"/>';}
 s+='</g>';
 /* the two axes run the card, with a diamond where each meets the outer ring; the eight tips
    carry a short spoke out to the great ring; the 20° spokes end in a small ring terminal */
 s+='<g stroke="'+faint+'" stroke-width="1.4">';
 for(i=0;i<4;i++){a=i*90;var m1=P(126,a),m2=P(a===0?351:a===180?372:470,a);s+='<line x1="'+m1[0]+'" y1="'+m1[1]+'" x2="'+m2[0]+'" y2="'+m2[1]+'"/>';if(a%180===0){var d=P(351,a);s+='<polygon points="'+diamond(d[0],d[1],6.5)+'" fill="'+ink+'"/>';}}
 for(i=0;i<4;i++){a=45+i*90;var k1=P(126,a),k2=P(309,a);s+='<line x1="'+k1[0]+'" y1="'+k1[1]+'" x2="'+k2[0]+'" y2="'+k2[1]+'"/>';}
 [20,160,200,340].forEach(function(a){var m1=P(126,a),m2=P(338,a);s+='<line x1="'+m1[0]+'" y1="'+m1[1]+'" x2="'+m2[0]+'" y2="'+m2[1]+'"/>';s+='<circle cx="'+m2[0]+'" cy="'+m2[1]+'" r="4.4" fill="'+paper+'" stroke="'+ink+'" stroke-width="1.6"/>';});
 s+='</g>';
 s+='</g>';
 /* ---- the two stars ---- */
 s+='<g fill="none" stroke="'+ink+'" stroke-linejoin="miter">';
 s+='<polygon points="'+poly(square(R1,0))+'" stroke-width="4"/>';
 s+='<polygon points="'+poly(square(R1,45))+'" stroke-width="4"/>';
 s+='<polygon points="'+poly(square(R2,0))+'" stroke-width="3.2"/>';
 s+='<polygon points="'+poly(square(R2,45))+'" stroke-width="3.2"/>';
 s+='</g>';
 /* ---- medallion ---- */
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="126" fill="'+paper+'"/>';
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="120" fill="none" stroke="'+ink+'" stroke-width="3.4" stroke-dasharray="0 8.2" stroke-linecap="round"/>';
 s+='<circle cx="'+CX+'" cy="'+CY+'" r="98" fill="none" stroke="'+ink+'" stroke-width="2.8"/>';
 /* wordmark: dotless i, the diamond placed by measuring the glyph after layout (see fixDot) */
 s+=logoSVG(CX,(CY+27),76,ink,'middle');   /* the logo, where the typed wordmark was */
 /* ---- frame ---- */
 s+='<rect x="'+fo+'" y="'+fo+'" width="'+(W-2*fo)+'" height="'+(H-2*fo)+'" rx="14" fill="none" stroke="'+ink+'" stroke-width="3.6"/>';
 if(FR.double)s+='<rect x="'+FR.double+'" y="'+FR.double+'" width="'+(W-2*FR.double)+'" height="'+(H-2*FR.double)+'" rx="11" fill="none" stroke="'+ink+'" stroke-width="1.5"/>';
 s+='<g fill="none" stroke="'+ink+'" stroke-width="1.3">'+innerRule(CD.chamfer,fi)+'</g>';
 /* frame markers at the sides and the two axis diamonds on the border */
 [[fo,CY-198],[fo,CY+198],[W-fo,CY-198],[W-fo,CY+198]].forEach(function(p){s+='<polygon points="'+diamond(p[0],p[1],7)+'" fill="'+ink+'"/>';});
 /* corner knots, seated on the frame */
 s+=corners(o.corner,ink,faint,paper,{fo:fo,fi:fi});
 /* ---- head: kicker, title, rule with its diamond ---- */
 /* The back is not anonymous: it names the card. A kicker in mono says what it is and where it
    sits (SURAH 113 · 5 AYAT · MAKKAN / DUA · KNOWLEDGE & STUDY); the title beneath it in the
    app's grotesk; a rule under both with a diamond at its centre, which the axis then picks up
    at the astrolabe's outer arc a little further down. Long titles shrink to fit the measure. */
 var kind=(o.kind||'DUA').toUpperCase(), kicker=(o.kicker||('BAIK · '+kind)).toUpperCase(), title=o.title||'';
 var esc=function(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');};
 var tsize=Math.min(31,Math.floor(430/(Math.max(title.length,12)*0.56)));
 s+='<text x="'+CX+'" y="66" text-anchor="middle" font-size="11.5" font-weight="500" letter-spacing="3.2" fill="'+ink+'">'+esc(kicker)+'</text>';
 s+='<text x="'+CX+'" y="106" text-anchor="middle" font-family="\'Space Grotesk\',\'Helvetica Neue\',Arial,sans-serif" font-weight="700" font-size="'+tsize+'" letter-spacing="-.2" fill="'+ink+'">'+esc(title)+'</text>';
 s+='<line x1="104" y1="126" x2="526" y2="126" stroke="'+ink+'" stroke-width="1.5"/>';
 s+='<polygon points="'+diamond(CX,126,6.5)+'" fill="'+ink+'"/>';
 /* ---- foot: source, collection line, code ---- */
 if(o.source)s+='<text x="'+CX+'" y="912" text-anchor="middle" font-size="11" font-weight="500" letter-spacing="2.6" fill="'+ink+'">'+esc(String(o.source).toUpperCase())+'</text>';
 s+='<text x="106" y="950" font-size="11.5" font-weight="500" letter-spacing="2.2" fill="'+ink+'">BAIK '+kind+' COLLECTION · '+esc(o.set||'SET 01')+'</text>';
 s+='<text x="524" y="951" text-anchor="end" font-size="14" font-weight="600" letter-spacing="1.5" fill="'+ink+'">'+esc(o.code||'')+'</text>';
 /* the axis marks the frame where it leaves the card, top and bottom */
 s+='<polygon points="'+diamond(CX,fo,7)+'" fill="'+ink+'" stroke="'+paper+'" stroke-width="1.6"/>';
 s+='<polygon points="'+diamond(CX,H-fo,7)+'" fill="'+ink+'" stroke="'+paper+'" stroke-width="1.6"/>';
 /* ---- surface: grain, vignette, gloss ---- */
 if(o.grain!==false)s+='<rect x="8" y="8" width="'+(W-16)+'" height="'+(H-16)+'" rx="22" filter="url(#'+id+'-grain)" opacity="1"/>';
 s+='<rect x="8" y="8" width="'+(W-16)+'" height="'+(H-16)+'" rx="22" fill="url(#'+id+'-vig)"/>';
 s+='<rect x="8" y="8" width="'+(W-16)+'" height="'+(H-16)+'" rx="22" fill="url(#'+id+'-gloss)"/>';
 s+='</svg>';
 return s;
}

/* ====================== BACK DESIGNS ======================
   A back is one entry here. It gets the same o as everything else — dark, kicker, title,
   source, code, set, grain — and returns a whole svg. `corners` says whether the corner
   library applies to it; a design that has no frame to seat a knot in says false. */
/* Two lines, the way the deck breaks them: an Arabic name and its meaning split at the middot,
   anything else balanced by word count so neither line is left with one word. */
function splitTitle(t){
 t=String(t||'').trim();
 var i=t.indexOf(' \u00b7 ');
 if(i>0)return [t.slice(0,i),t.slice(i+3)];
 var w=t.split(/\s+/);if(w.length<2)return [t,''];
 var best=1,d=1e9;
 for(var k=1;k<w.length;k++){var a=w.slice(0,k).join(' ').length,b=w.slice(k).join(' ').length;
  if(Math.abs(a-b)<d){d=Math.abs(a-b);best=k;}}
 return [w.slice(0,best).join(' '),w.slice(best).join(' ')];
}
/* The mihrab: a prayer niche drawn as one open line. Nothing fills it and nothing closes it at
   the foot, so the card reads as a doorway rather than a panel.
   The curve is ONE smooth profile per side, a cubic: it leaves the leg vertically (so leg
   and arch join with no kink), swells into a broad shoulder, then pinches into a soft point
   at the apex. Three numbers shape it — where the shoulder sits (SH, a fraction of the rise),
   how far the approach to the apex pulls toward the axis (PX), and how steeply it arrives
   (PY). The two sides are mirror images, so symmetry is guaranteed rather than tuned.
   The point is soft on purpose: the arcs of a two-centred arch meet at a fixed angle and read
   as masonry; this reads as a niche drawn in one breath. */
function mihrabSVG(o){
 var dark=!!o.dark, id=o.id||'b';
 var paper=dark?'#0E0F10':'#F5F4F0', rim=dark?'#E8E7E3':'#FFFFFF', ink=dark?'#F3F2EE':'#17181A';
 var soft=dark?'rgba(243,242,238,.34)':'rgba(23,24,26,.30)';
 var esc=function(t){return String(t==null?'':t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');};
 /* span 400 = 63% of the card: wide enough to read as a doorway, narrow enough that an
    equilateral rise still clears the title above it */
 /* proportions measured off the reference: legs start near the card's lower sides at 73%
    of its width, the shoulder sits low, the apex lands in the upper-middle */
 /* PX and PY set how the curve arrives at the apex. Small PX with large PY brings it in
