<script is:inline>
/* The diamond over the dotless i. Its X comes from the laid-out glyph, so it lands on the stem
   whatever font the browser fell back to. Its Y and size are derived from THAT wordmark's own
   baseline and font-size — 0.72 em above the baseline is where a tittle sits.
   This used to end 'y = CY - 30', which is the plate's wordmark position written as a constant.
   The plate puts its wordmark near the middle of the card; the celestial and fret backs put
   theirs lower down. So on those two the dot was being moved to the plate's height and left
   floating a long way above the word. Anything that depends on where the wordmark is has to be
   read from the wordmark. */
function fixDot(svg){
 var t=svg.querySelector('.wm'),d=svg.querySelector('.wm-dot');if(!t||!d||!t.getStartPositionOfChar)return;
 try{
  var a=t.getStartPositionOfChar(2),b=t.getEndPositionOfChar(2),x=(a.x+b.x)/2;
  var base=parseFloat(t.getAttribute('y')),fz=parseFloat(t.getAttribute('font-size'))||76;
  d.setAttribute('points',diamond(f(x),f(base-fz*0.72),f(fz*0.085)));
 }catch(e){}
}
