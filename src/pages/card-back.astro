  if(b.dataset.act==='copy'){navigator.clipboard.writeText(svg).then(function(){b.textContent='copied';b.classList.add('ok');setTimeout(function(){b.textContent='copy svg';b.classList.remove('ok');},1200);});}
  else{var a=document.createElement('a');a.href='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);a.download='baik-back-'+(b.closest('.card').querySelector('.wm')?'':'')+(svg.indexOf('SURAH')>0?'surah':'dua')+'.svg';a.click();}
 });});
}
['c1','c2','k1','t1','s1','k2','t2','s2','set','grain'].forEach(function(id){document.getElementById(id).addEventListener('input',draw);});
drawCorners();draw();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(function(){document.querySelectorAll('#row svg').forEach(fixDot);});
