---
import Head from "../layouts/Head.astro";
---
<!doctype html>
<html lang="en">
<head>
<link rel="stylesheet" href="/css/khayr.css">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Baik · The right dua for what you are facing</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2064%2064%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%2260%22%20height%3D%2260%22%20rx%3D%2217%22%20fill%3D%22%231E2124%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2234%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22central%22%20font-family%3D%22Space%20Grotesk%2C%20Helvetica%2C%20sans-serif%22%20font-weight%3D%22700%22%20font-size%3D%2240%22%20fill%3D%22%23FFFFFF%22%3Eb%3C%2Ftext%3E%3Crect%20x%3D%2241%22%20y%3D%2215%22%20width%3D%227%22%20height%3D%227%22%20rx%3D%221%22%20transform%3D%22rotate%2845%2044.5%2018.5%29%22%20fill%3D%22%23FFFFFF%22%2F%3E%3C%2Fsvg%3E">
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2064%2064%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Crect%20x%3D%222%22%20y%3D%222%22%20width%3D%2260%22%20height%3D%2260%22%20rx%3D%2217%22%20fill%3D%22%231E2124%22%2F%3E%3Ctext%20x%3D%2232%22%20y%3D%2234%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22central%22%20font-family%3D%22Space%20Grotesk%2C%20Helvetica%2C%20sans-serif%22%20font-weight%3D%22700%22%20font-size%3D%2240%22%20fill%3D%22%23FFFFFF%22%3Eb%3C%2Ftext%3E%3Crect%20x%3D%2241%22%20y%3D%2215%22%20width%3D%227%22%20height%3D%227%22%20rx%3D%221%22%20transform%3D%22rotate%2845%2044.5%2018.5%29%22%20fill%3D%22%23FFFFFF%22%2F%3E%3C%2Fsvg%3E">
<meta name="theme-color" content="#F3F3F3">

<script is:inline>if(/^https?:$/.test(location.protocol))document.documentElement.classList.add('authwait');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Scheherazade+New:wght@500;700&family=Reem+Kufi:wght@400;500;600;700&family=Amiri:wght@400;700&family=Amiri+Quran&display=swap" rel="stylesheet">
<Head />
</head>
<body>

<a class="skip" href="#deck">Skip to the deck</a>
<h1 class="sr-only">Baik · the right dua for what you are facing</h1>
<header class="top">
  <div class="wm"><span class="wm-en"><span class="bkw"><span class="baik-logo" role="img" aria-label="Baik"></span></span></span></div>
  <div class="top-r">
    <div class="top-scroll">
    <button class="npchip" id="npChip" hidden type="button" aria-label="Next prayer. Opens prayer times."><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.3l3.4 2"/></svg><span class="np-n" id="npN"></span><span class="np-c" id="npC"></span></button>
    <div class="abtn" title="Arabic text size"><button id="arMinus" aria-label="Smaller Arabic text">A−</button><span class="ar-lv" id="arLv" role="status" aria-live="polite"><i><b></b><b></b><b></b><b></b></i><em></em></span><button id="arPlus" aria-label="Larger Arabic text">A+</button><button id="arFont" title="Arabic script" aria-label="Arabic script" class="arf" aria-haspopup="menu" aria-expanded="false">ع</button><div class="arf-m" id="arfMenu" hidden role="menu"></div></div>
    <div class="lang"><button class="on" id="enBtn"><svg class="fl" viewBox="0 0 60 30"><clipPath id="fgb"><rect width="60" height="30"/></clipPath><g clip-path="url(#fgb)"><rect width="60" height="30" fill="#012169"/><path d="M0 0l60 30M60 0L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30M60 0L0 30" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></g></svg>EN</button><button id="bmBtn"><svg class="fl" viewBox="0 0 60 30"><rect width="60" height="30" fill="#fff"/><g fill="#CC0001"><rect width="60" height="2.14"/><rect y="4.28" width="60" height="2.14"/><rect y="8.56" width="60" height="2.14"/><rect y="12.84" width="60" height="2.14"/><rect y="17.12" width="60" height="2.14"/><rect y="21.4" width="60" height="2.14"/><rect y="25.68" width="60" height="2.14"/></g><rect width="34" height="17.12" fill="#010066"/><circle cx="15" cy="8.5" r="5" fill="#FC0"/><circle cx="16.8" cy="8.5" r="4.2" fill="#010066"/><path d="M22.5 5.2l.9 2.6 2.7.05-2.15 1.65.78 2.6-2.23-1.55-2.23 1.55.78-2.6-2.15-1.65 2.7-.05z" fill="#FC0"/></svg>BM</button></div>
    <div class="lang plat" title="Preview the web layout or the phone app layout"><button id="webBtn" class="on">Web</button><button id="appBtn">App</button></div>
    <button class="gbtn" id="planBtn">Free &amp; Premium</button>
    </div>
    <div class="ovf">
      <button class="ovf-b" id="ovfBtn" aria-haspopup="true" aria-expanded="false" aria-label="More"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5.5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="18.5" cy="12" r="1.7"/></svg></button>
      <div class="ovf-m" id="ovfMenu" hidden role="menu">
        <button type="button" id="qibBtn" role="menuitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg>Qibla direction</button>
        <button type="button" id="qptBtn" role="menuitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.3l3.4 2"/></svg>Prayer times</button>
        <a href="/" role="menuitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>Baik website</a>
        <a href="/codex" role="menuitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10 4.5 7 4 4 4.5v13c3-.5 6 0 8 2 2-2 5-2.5 8-2v-13c-3-.5-6 0-8 2z"/><path d="M12 6.5v13"/></svg>Codex · system reference</a>
        <div class="ovf-d adm" role="separator"></div>
        <div class="ovf-k adm">Admin</div>
        <a href="/audit" role="menuitem" class="adm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6v3H9zM6 6H5v15h14V6h-1"/><path d="M8.5 13l2.4 2.4L15.5 11"/></svg>App audit</a>
        <a href="/competitors" role="menuitem" class="adm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>Competitors</a>
        <a href="/plan" role="menuitem" class="adm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h16M4 19h9"/><circle cx="19" cy="19" r="2.2"/></svg>Plan</a>
        <a href="/khayr#map" role="menuitem" class="adm" id="ovfMap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.3"/><circle cx="5" cy="18" r="2.3"/><circle cx="19" cy="18" r="2.3"/><path d="M12 7.3v4.4M12 11.7L6.4 16M12 11.7L17.6 16"/></svg>Deck map · the galaxy</a>
      </div>
    </div>
    <button class="savbtn" id="savBtn" type="button" data-tip="Saved|The cards you bookmarked, laid out on your table.|Yours" aria-label="Saved cards"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.8l2.4 5 5.5.7-4 3.8 1.1 5.5L12 16.2l-5 2.6 1.1-5.5-4-3.8 5.5-.7z"/></svg><em id="savN" hidden>0</em></button>
    <button class="avbtn" id="acBtn" title="My account" aria-label="My account"><span id="acAv"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c1.4-3.4 4-5 7-5s5.6 1.6 7 5"/></svg></span><span class="avlbl" id="acLbl">My account</span></button>
  </div>
</header>

<noscript>
  <div class="nojs">
    <b>Baik needs JavaScript to lay out the deck.</b>
    <p>The duas themselves are plain text and lose nothing by it, but the cards, the search and
    the filters are all drawn in the browser. Turn JavaScript on for this page and the deck appears.</p>
    <p class="nojs-alt">If you would rather not, the <a href="/">Baik website</a> reads fully without it.</p>
  </div>
</noscript>

<div id="stage"><div id="stageIn">

<div class="daily" id="daily"></div>
<!-- the first-visit note sits under the daily strip and borrows its grammar: kicker, line, sub, one square X -->
<div class="firstrun" id="firstrun" hidden>
  <span class="fr-k">New here</span>
  <span class="dtxt"><b id="frTitle">Three ways to hold the deck</b><span class="dsub" id="frText">The <b>grid</b> scans everything, the <b>deck</b> draws one card at a time, the <b>table</b> lays out what you are facing. The buttons beside the filter switch between them.</span></span>
  <button class="dx" id="frX" type="button" aria-label="Got it">×</button>
</div>

<nav class="bar" id="bar" aria-label="Find a dua">
  <div class="finder" id="finder">
    <label class="search"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6E6E6E" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="6.6"/><path d="M20.5 20.5l-4.8-4.8"/></svg><input id="q" type="search" placeholder="Search duas, situations, meanings..." autocomplete="off"><button class="qx" id="qx" type="button" aria-label="Clear search" hidden>×</button></label>
    <div class="rcd" id="rcd" hidden>
      <button class="fbtn" id="rcdBtn" aria-expanded="false" aria-haspopup="menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.2"/><path d="M12 7.4v4.9l3.1 1.9"/></svg>
        <span id="rcdLabel">Recent</span><small id="rcdN"></small>
        <svg class="cv" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="rcd-m" id="rcdMenu" hidden role="menu"></div>
    </div>
    <button class="fbtn" id="ftog" aria-expanded="false" aria-controls="fpanel" aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16M4 16h16"/><circle cx="9" cy="8" r="2.2" fill="#FFFFFF"/><circle cx="15" cy="16" r="2.2" fill="#FFFFFF"/></svg>
      <span class="fbl">Filter tags</span><span class="fcount" id="fcount" hidden>0</span>
      <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="viewtog" role="group" aria-label="Layout">
      <button id="vMap" class="on" data-tip="Galaxy|Every card as a star around one light, gathered by need. Turn it, tap a need, tap a star.|View" aria-label="Galaxy view" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.3"/><ellipse cx="12" cy="12" rx="9" ry="3.6" transform="rotate(-25 12 12)"/><circle cx="19.4" cy="7.6" r="1.3" fill="currentColor" stroke="none"/></svg></button>
      <button id="vGrid" data-tip="Grid|Every card laid out by need. Scan the whole deck.|View" aria-label="Grid view" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="6.6" height="6.6" rx="1.8"/><rect x="13.4" y="4" width="6.6" height="6.6" rx="1.8"/><rect x="4" y="13.4" width="6.6" height="6.6" rx="1.8"/><rect x="13.4" y="13.4" width="6.6" height="6.6" rx="1.8"/></svg></button>
      <button id="vTable" data-tip="Table|Lay saved cards out and move them around, or ask the table to deal a spread for what you are facing.|View" aria-label="Table view" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="7.5" width="5.2" height="10" rx="1.4"/><rect x="9.4" y="5" width="5.2" height="12.5" rx="1.4"/><rect x="15.6" y="7.5" width="5.2" height="10" rx="1.4"/><path d="M3 20.5h18"/></svg></button>
      <button id="vSys" data-tip="Deck stats|What the deck is made of: kinds, sets and needs, and where it is still thin. Tap a row to filter.|View" aria-label="Stats view" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5.5 20v-7M12 20V5M18.5 20v-9"/></svg></button>
    </div>
    <div class="fpanel" id="fpanel" hidden>
      <div class="fpanel-groups">
        <div class="fgroup"><div class="fg-k" id="fgSet">Set <em>pick one</em></div><div class="fopts" id="setRow" role="radiogroup" aria-labelledby="fgSet"></div></div>
        <div class="fgroup"><div class="fg-k" id="fgKind">Kind <em>pick one</em></div><div class="fopts" id="kindRow" role="radiogroup" aria-labelledby="fgKind"></div></div>
        <div class="fgroup"><div class="fg-k" id="fgCat">Category <em>tick any</em></div><div class="fopts" id="catRow" role="group" aria-labelledby="fgCat"></div></div>
      </div>
      <div class="fpanel-foot">
        <button class="fp-clear" id="fpClear">Reset all</button>
        <button class="fp-done" id="fpDone">Done</button>
      </div>
    </div>
  </div>
  <div class="ftags" id="ftags" hidden></div>
  <div class="chiprow r-sit"><div class="chips" id="sitRow"></div></div>
  <div class="chiprow r-recent" hidden><div class="chips" id="recentRow" style="display:none"></div></div>
</nav>

<p class="sr-only" id="deckCount" role="status" aria-live="polite"></p>
<main class="main"><div class="deckwrap" id="deck"></div></main>

</div></div>

<div class="spot" id="spot">
  <button class="spot-x" id="spotX" aria-label="Close">✕</button>
  <div class="spot-in">
    <div class="spot-zoom" id="spotZoom"><div class="spot-card" id="spotCard"></div></div>
    <div class="spot-bar" id="spotBar"></div>
    <button class="spot-nav" id="spotPrev" aria-label="Previous card">‹</button>
    <button class="spot-nav" id="spotNext" aria-label="Next card">›</button>
  </div>
</div>

<div class="plan" id="plan"><div class="plan-in">
  <div class="plan-h">
    <div><h2>Free forever. Premium supports the app.</h2>
    <p>All authentic duas and essential religious guidance stay free. Premium supports the app and unlocks advanced learning, personalisation, guided journeys and audio tools. It never unlocks duas.</p></div>
    <button class="plan-x" id="planX" aria-label="Close">✕</button>
  </div>
  <div class="prices">
    <div class="price hero"><div class="pk">Free</div><div class="pv">RM0</div><div class="pd">Forever. Every authentic dua and essential tool.</div></div>
    <div class="price"><div class="pk">Monthly</div><div class="pv">RM19.90</div><div class="pd">Per month.</div></div>
    <div class="price"><div class="pk">Annual</div><div class="pv">RM179.10</div><div class="pd">Per year, 25% off monthly.</div></div>
    <div class="price"><div class="pk">Lifetime</div><div class="pv">RM358.20</div><div class="pd">Two years' worth, one payment.</div></div>
    <div class="price"><div class="pk">Founding member</div><div class="pv">RM129.90</div><div class="pd">Lifetime, first 1,000 users.</div></div>
    <div class="price"><div class="pk">Trial</div><div class="pv">7 days</div><div class="pd">Full Premium, reminder before billing.</div></div>
  </div>
  <div id="planBody"></div>
</div></div>

<div class="ac" id="ac"><div class="ac-in">
  <button class="pw-x" id="acX" aria-label="Close">✕</button>
  <div id="acBody"></div>
</div></div>

<div class="pay" id="pay"><div class="pay-in">
  <button class="pw-x" id="payX" aria-label="Close">✕</button>
  <div id="payBody"></div>
</div></div>

<div class="nudge" id="nudge" hidden>
  <button class="nudge-x" id="nudgeX" aria-label="Not now">✕</button>
  <div class="nudge-k">One a morning</div>
  <p class="nudge-p">Want a single dua in your inbox each morning? One card, nothing else.</p>
  <form class="nudge-f" id="nudgeF">
    <input type="email" id="nudgeMail" placeholder="you@example.com" autocomplete="email" aria-label="Email for the daily dua">
    <button type="submit">Yes</button>
  </form>
  <span class="nudge-n">Free, never sold, stop any time.</span>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

<div class="qib" id="qib" aria-labelledby="qibH">
 <div class="qib-in">
  <button class="pw-x" id="qibX" aria-label="Close">✕</button>
  <div class="qib-k" id="qibK">Qibla</div>
  <h3 class="qib-h" id="qibH">The direction of the Kaaba</h3>
  <p class="qib-sub">Makkah al-Mukarramah · 21.4225°N 39.8262°E</p>

  <div class="qib-dial">
   <svg viewBox="0 0 200 200" role="img" aria-labelledby="qibSvgT">
    <title id="qibSvgT">Compass dial with the qibla bearing marked</title>
    <circle class="qr-ring" cx="100" cy="100" r="92"/>
    <g class="qr-rose" id="qRose">
     <g id="qTicks"></g>
     <text class="qr-c n" x="100" y="30">N</text>
     <text class="qr-c" x="170" y="100">E</text>
     <text class="qr-c" x="100" y="170">S</text>
     <text class="qr-c" x="30" y="100">W</text>
     <g id="qKaaba">
      <line class="qr-ray" x1="100" y1="100" x2="100" y2="52"/>
      <g transform="translate(100,40)"><g id="qKbR">
       <rect class="qr-kb" x="-9" y="-9.5" width="18" height="19" rx="1.5"/>
       <path class="qr-kbb" d="M-9 -3.5h18"/>
      </g></g>
     </g>
    </g>
    <line class="qr-you-l" x1="100" y1="100" x2="100" y2="14"/>
    <circle class="qr-hub" cx="100" cy="100" r="3.4"/>
    <path class="qr-you" d="M100 3 l6.5 12 h-13 z"/>
   </svg>
  </div>

  <div class="qib-deg" id="qibDeg">—</div>
  <div class="qib-degk" id="qibDegK">degrees from true north</div>
  <div class="qib-turn" id="qibTurn" role="status" aria-live="polite"></div>
  <div class="qib-meta" id="qibMeta">Set your location to get the bearing.</div>

  <div class="qib-row">
   <button class="qib-b pri" id="qibGeo" type="button">Use my location</button>
   <button class="qib-b" id="qibComp" type="button" hidden>Turn on compass</button>
   <button class="qib-b" id="qibCam" type="button" hidden>Camera view</button>
   <button class="qib-b" id="qibSunB" type="button">Find north by the sun</button>
  </div>

  <button class="qib-link" id="qibCityB" type="button" aria-expanded="false" aria-controls="qibCityWrap">Set location by city</button>
  <div class="qib-sel" id="qibCityWrap" hidden><select id="qibCity" aria-label="Pick a city"></select></div>

  <div class="qib-sun" id="qibSun" hidden></div>

  <div class="qib-note" id="qibNote" data-base="1">A phone compass is a magnetometer: metal, speakers, cases and cars pull it off. Turn the phone in a slow figure of eight to settle it, and check it against the sun before you rely on it. The bearing itself is exact — only the compass needle is a guess.</div>
 </div>
</div>

<div class="qib qpt" id="qpt" aria-labelledby="qptH">
 <div class="qib-in">
  <button class="pw-x" id="qptX" aria-label="Close">✕</button>
  <div class="qib-k" id="qptK">Prayer times</div>
  <h3 class="qib-h" id="qptH">Today</h3>
  <p class="qib-sub" id="qptLoc">Set your location to get today’s times.</p>

  <div class="qtc" id="qtc" hidden>
   <div class="qtc-k" id="qtcK">Next prayer</div>
   <div class="qtc-n" id="qtcName">—</div>
   <div class="qtc-t" id="qtcTime"></div>
   <div class="qtc-rings" role="timer" aria-live="off" aria-label="Time until the next prayer">
    <div class="qtc-r">
