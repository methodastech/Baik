---
import Head from "../layouts/Head.astro";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Not here · Baik</title>
<meta name="description" content="That page is not at Baik. Open the deck instead.">
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#F3F3F3">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Saira:wght@400;600;700&display=swap" rel="stylesheet">
<Head />
<style is:global>
  :root { --ink:#1E2124; --paper:#F3F3F3; }
  html,body { margin:0; height:100%; }
  body {
    background:var(--paper); color:var(--ink);
    font-family:Saira,system-ui,-apple-system,"Segoe UI",sans-serif;
    display:grid; place-items:center; text-align:center; padding:24px;
  }
  .wrap { max-width:34rem; }
  h1 { font-size:clamp(2rem,8vw,3.5rem); margin:0 0 .5rem; letter-spacing:-.02em; }
  p { font-size:clamp(1rem,3.5vw,1.125rem); line-height:1.6; opacity:.75; margin:0 0 2rem; }
  .go {
    display:inline-block; padding:.9rem 1.8rem; border-radius:999px;
    background:var(--ink); color:var(--paper); text-decoration:none; font-weight:600;
  }
  .go + .go { background:transparent; color:var(--ink); box-shadow:inset 0 0 0 1px currentColor; margin-left:.5rem; }
</style>
</head>
<body>
  <main class="wrap">
    <h1>Not here</h1>
    <p>That page does not exist at Baik. The deck is still waiting for you.</p>
    <a class="go" href="/khayr">Open the deck</a>
    <a class="go" href="/">Back to the start</a>
  </main>
</body>
</html>
