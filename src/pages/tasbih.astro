---
import Loader from "../components/Loader.astro";
import Head from "../layouts/Head.astro";
---
<!doctype html>
<html lang="en">
<head>
<link rel="stylesheet" href="/css/khayr.css">
<link rel="stylesheet" href="/css/tasbih.css">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Tasbih · Baik</title>
<meta name="description" content="A digital tasbih: tap to move a bead and count your dhikr.">
<meta name="theme-color" content="#0E1513">
<script is:inline>if(/^https?:$/.test(location.protocol))document.documentElement.classList.add('authwait');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Saira:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Scheherazade+New:wght@500;700&display=swap" rel="stylesheet">
<Head />
</head>
<body class="tbpage">
<Loader />
<header class="tb-top">
 <a href="/khayr" aria-label="Back to Baik"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg></a>
 <h1>Tasbih</h1>
 <button type="button" id="tbReset" aria-label="Reset the count"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v5h5"/></svg></button>
 <button type="button" id="tbSound" aria-label="Sound" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path class="wv" d="M16.5 8.8a4.5 4.5 0 0 1 0 6.4M19 6.5a8 8 0 0 1 0 11"/><path class="mute" d="M17 9l5 6M22 9l-5 6"/></svg></button>
</header>

<div class="tb-area" id="tbArea" role="button" aria-label="Tap to count, swipe from right to left to take one back">
 <div class="tb-head">
  <div class="tb-n" id="tbN" aria-live="polite">00</div>
  <div class="tb-goal" id="tbGoal"></div>
  <div class="tb-bar"><i id="tbBar"></i></div>
  <div class="tb-steps" id="tbSteps"></div>
 </div>
 <div class="tb-stage">
  <canvas id="tbCv" aria-hidden="true"></canvas>
  <canvas id="tbGl" aria-hidden="true"></canvas>
 </div>
 <div class="tb-words">
  <div class="tb-ar" id="tbAr" lang="ar"></div>
  <div class="tb-tr" id="tbTr"></div>
  <div class="tb-hint" id="tbHint">Tap anywhere to count<br>(swipe from right to left to take one back)</div>
 </div>
 <div class="tb-today" id="tbToday"></div>
</div>

<div class="tb-scrim" id="tbScrim" aria-hidden="true"></div>
<section class="tb-panel" id="tbPanel" aria-label="Dhikr and beads">
 <button type="button" class="tb-handle" id="tbHandle" aria-expanded="false" aria-controls="tbList" aria-label="Show every dhikr"></button>
 <div class="tb-row"><b>Current dhikr<small id="tbCur"></small></b><button type="button" id="tbAll">View all</button></div>
 <div class="tb-beads" id="tbBeads" role="group" aria-label="Bead"></div>
 <div class="tb-sounds" id="tbSounds" role="group" aria-label="Sound"><span>Sound</span></div>
 <div class="tb-list" id="tbList" role="group" aria-label="Dhikr"></div>
</section>

<dialog class="tb-ask" id="tbAsk" aria-labelledby="tbAskT" aria-describedby="tbAskP">
 <div class="tb-ask-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v5h5"/></svg></div>
 <h2 id="tbAskT">Reset this count?</h2>
 <p id="tbAskP"></p>
 <div class="tb-ask-b"><button type="button" id="tbAskNo">Cancel</button><button type="button" id="tbAskYes">Reset</button></div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
<script is:inline src="/js/sky-base.js"></script>
<script is:inline src="/js/tasbih.js"></script>
<script is:inline type="importmap">{"imports":{"three":"/js/vendor/three/three.module.js","three/addons/":"/js/vendor/three/addons/"}}</script>
<script is:inline type="module" src="/js/tasbih3d.js"></script>
</body>
</html>
