<!doctype html>
<html lang="en">
<head>
<link rel="stylesheet" href="/css/card-tcg.css">

</head>
<body> charset="utf-8">
<title>On You We Rely</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@600;700&family=JetBrains+Mono:wght@500;700&family=Scheherazade+New:wght@500;700&display=swap">


<main class="wrap">
 <header class="lede">
  <div class="k">Design try-out &middot; one card</div>
  <h1>Rabbana 022 as a collectible</h1>
  <p>Same layout, type, dua and source. Foil on the framing only. Move the pointer over the card.</p>
 </header>

 <div class="stage">
  <article class="card" id="hero" data-edge="gold" aria-label="On You We Rely, To You We Turn">
   <div class="stock"><div class="key">
    <header class="hd">
     <div><h2 class="t">On You We Rely, To You We Turn</h2><div class="k">Dua &middot; Rabbana Set</div></div>
     <div class="medal">22</div>
    </header>
    <figure class="art"><img src="data:image/webp;base64," alt=""></figure>
    <ul class="attrs">
     <li class="a-heart"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 20.4 5.1 13.5a4.55 4.55 0 1 1 6.43-6.43l.47.47.47-.47a4.55 4.55 0 1 1 6.43 6.43L12 20.4ZM8 11.15v1.9h8v-1.9H8Z"/></svg>Anxiety &amp; the Heart</li>
     <li class="a-know"><svg viewBox="0 0 24 24"><path d="M12 3.2a5.7 5.7 0 0 0-3.3 10.3c.6.5.9 1.1.9 1.8v.6h4.8v-.6c0-.7.3-1.3.9-1.8A5.7 5.7 0 0 0 12 3.2Z"/><rect x="9.5" y="17.2" width="5" height="1.7" rx=".85"/><rect x="10.2" y="20" width="3.6" height="1.5" rx=".75"/></svg>Knowledge &amp; Study</li>
    </ul>
    <section class="text">
     <p class="ar" lang="ar">رَّبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ ٱلْمَصِيرُ</p>
     <p class="tr">rabbanā ʿalayka tawakkalnā wa-ilayka anabnā wa-ilayka l-maṣīru</p>
     <blockquote class="en">&ldquo;Our Lord, upon You we have relied, and to You we have returned, and to You is the destination.&rdquo;</blockquote>
    </section>
    <footer class="bar">
     <svg class="em" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14"/><rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)"/></svg>
     <span>Rabbana Set 01</span><span class="dot">&middot;</span><span>022 / 022</span>
     <span class="src">Al-Mumtahanah 60:4</span>
    </footer>
   </div></div>
  </article>
 </div>

 <section class="row" id="edges" aria-label="Edge treatments"></section>

 <dl class="spec">
  <b>Stock</b><span><i class="sw" style="background:#F6F2E9"></i>ivory, paper grain at 5%, geometric tile under the text panel at 13%</span>
  <b>Edge</b><span><i class="sw" style="background:#C7B27C"></i>champagne, 3px metallic + 1px keyline; sheen slides across the frame on hover</span>
  <b>Accent</b><span><i class="sw" style="background:#C8664A"></i>coral on the heart, <i class="sw" style="background:#1D7276"></i>teal on knowledge &mdash; icon and edge only, text stays ink</span>
  <b>Type</b><span>Space Grotesk &middot; JetBrains Mono &middot; Saira &middot; Scheherazade New &mdash; the deck&rsquo;s own stack</span>
  <b>Collector</b><span>22 of 22 in the Rabbana set (not 114 &mdash; that&rsquo;s the surah count)</span>
 </dl>
</main>

<script is:inline>
(function(){
 var hero=document.getElementById('hero'), row=document.getElementById('edges');
 var edges=[['silver','Common','silver edge'],['teal','Reflection','teal edge'],['gold','Deep','champagne edge'],['holo','Featured','iridescent edge']];
 edges.forEach(function(e){
  var f=document.createElement('figure'), box=document.createElement('div'), c=hero.cloneNode(true);
  c.removeAttribute('id'); c.setAttribute('data-edge',e[0]); c.removeAttribute('aria-label');
  box.className='mini'; box.appendChild(c);
  var cap=document.createElement('figcaption'); cap.innerHTML='<b>'+e[1]+'</b>'+e[2];
  f.appendChild(box); f.appendChild(cap); row.appendChild(f);
 });
 if(!matchMedia('(hover:hover) and (pointer:fine)').matches)return;
 if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
 var raf=0,cx=0,cy=0,rest=true;
 function paint(){raf=0;var s=hero.style;
  if(rest){s.setProperty('--rx','0deg');s.setProperty('--ry','0deg');return;}
  var r=hero.getBoundingClientRect();
  var px=((cx-r.left)/r.width)*2-1, py=((cy-r.top)/r.height)*2-1;
  s.setProperty('--rx',(py*-5).toFixed(2)+'deg');
  s.setProperty('--ry',(px*6).toFixed(2)+'deg');}
 hero.addEventListener('pointerenter',function(){rest=false;hero.classList.add('track');});
 hero.addEventListener('pointermove',function(e){cx=e.clientX;cy=e.clientY;rest=false;if(!raf)raf=requestAnimationFrame(paint);});
 hero.addEventListener('pointerleave',function(){rest=true;hero.classList.remove('track');if(!raf)raf=requestAnimationFrame(paint);});
})();
</script>
</body>
</html>
