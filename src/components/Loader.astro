---
/* The opening screen of the signed-in pages (/khayr, /qibla, /prayer-times, /tasbih).
   It covers the page while html.authwait holds it back, and after a fresh sign-in
   (login sets sessionStorage baik.in) it plays through once in full as html.bk-intro.
   The letters of the wordmark rise from the baseline one after another, the diamond over
   the i drops into place last, then turns a quarter, like a bead moving, until the page is
   ready. A quick check never shows it at all: it waits a quarter second before appearing.
   Styles live in khayr.css (.bk-load), which every one of these pages loads in <head>. */
---
<div class="bk-load" id="bkLoad" aria-hidden="true">
 <div class="bk-mark">
  <!-- each letter is its own layer, so the rise runs on the graphics thread even while the page's
       scripts keep the main thread busy; .bk-c clips at the baseline the letters rise from -->
  <span class="bk-c"><span class="bk-l" style="--i:0"><svg viewBox="0 0 118.13 45.82" preserveAspectRatio="none" focusable="false"><defs><mask id="bkCutB" maskUnits="userSpaceOnUse" x="-10" y="-10" width="140" height="70"><rect x="-10" y="-10" width="140" height="70" fill="#fff"/><g fill="#000"><path d="M9.05 12.16H19.44A4.26 4.26 0 0 1 19.44 20.68H9.05Z"/><path d="M9.05 28.08H20.44A4.56 4.56 0 0 1 20.44 37.2H9.05Z"/></g></mask></defs><g fill="currentColor" mask="url(#bkCutB)"><polygon points="0,4.16 9.05,4.16 9.05,45.2 0,45.2"/><path d="M0 4.16H21.14A11.96 11.96 0 0 1 21.14 28.08H0Z"/><path d="M0 20.68H22.14A12.26 12.26 0 0 1 22.14 45.2H0Z"/></g></svg></span></span>
  <span class="bk-c"><span class="bk-l" style="--i:1"><svg viewBox="0 0 118.13 45.82" preserveAspectRatio="none" focusable="false"><defs><mask id="bkCutA" maskUnits="userSpaceOnUse" x="-10" y="-10" width="140" height="70"><rect x="-10" y="-10" width="140" height="70" fill="#fff"/><g fill="#000"><circle cx="53.78" cy="31.15" r="6.96"/><polygon points="60.73,16 56.23,16 60.73,19.7"/><polygon points="60.73,46.3 56.23,46.3 60.73,42.5"/></g></mask></defs><g fill="currentColor" mask="url(#bkCutA)"><ellipse cx="53.78" cy="31" rx="15.43" ry="14.79"/><polygon points="60.73,16.9 69.38,16.9 69.38,45.2 60.73,45.2"/></g></svg></span></span>
  <span class="bk-c"><span class="bk-l" style="--i:2"><svg viewBox="0 0 118.13 45.82" preserveAspectRatio="none" focusable="false"><polygon fill="currentColor" points="75.13,20.26 84.18,16.9 84.18,45.2 75.13,45.2"/></svg></span></span>
  <span class="bk-c"><span class="bk-l" style="--i:3"><svg viewBox="0 0 118.13 45.82" preserveAspectRatio="none" focusable="false"><g fill="currentColor"><polygon points="89.4,7.69 98.33,4.16 98.33,28.6 99.53,29.7 99.53,33 98.33,33.7 98.33,45.2 89.4,45.2"/><polygon points="98.33,28.46 107.15,16.9 118.13,16.9 106.3,30.6 117.97,45.2 108.02,45.2 98.33,33.85"/></g></svg></span></span>
  <span class="bk-dot"><span class="bk-dot-in"><svg viewBox="73.36 0 12.6 12.6" focusable="false"><polygon fill="currentColor" points="79.66,0 85.96,6.3 79.66,12.6 73.36,6.3"/></svg></span></span>
 </div>
 <div class="bk-line"></div>
</div>
<script is:inline>
(function(){
 var h=document.documentElement, el=document.getElementById('bkLoad'), intro=false;
 try{intro=sessionStorage.getItem('baik.in')==='1';if(intro)sessionStorage.removeItem('baik.in');}catch(e){}
 if(intro){
  h.classList.add('bk-intro');
  // long enough for the letters, the diamond and one turn; longer only if the page is still loading
  setTimeout(function(){h.classList.remove('bk-intro');},matchMedia('(prefers-reduced-motion: reduce)').matches?500:1900);
 }else el.style.setProperty('--d','.25s');
 // once it has faded out it is gone for good
 el.addEventListener('transitionend',function(e){if(e.target===el&&!h.classList.contains('authwait')&&!h.classList.contains('bk-intro'))el.remove();});
})();
</script>
